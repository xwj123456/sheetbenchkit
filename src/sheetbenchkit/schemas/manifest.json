{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      },
      "minItems": 1,
      "maxItems": 4
    },
    "unit_labels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intentional_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "business_confirmation": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/json"
      }
    },
    "variant_recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "category",
    "inputs",
    "unit_labels",
    "intentional_boundaries",
    "business_confirmation",
    "variant_recipes"
  ],
  "additionalProperties": false,
  "$defs": {
    "input": {
      "type": "object",
      "properties": {
        "file_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "csv",
            "xlsx"
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_missing": {
          "type": "boolean"
        }
      },
      "required": [
        "file_id",
        "relative_path",
        "format",
        "sha256",
        "expected_missing"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_missing": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "recipe": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "target_numeric",
            "distractor_numeric",
            "target_filter",
            "distractor_filter",
            "column_shuffle"
          ]
        },
        "file_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "header_row": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "field": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "row": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "numeric_delta": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "text_replacement": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "file_id",
        "sheet",
        "header_row",
        "rows",
        "field",
        "row",
        "numeric_delta",
        "text_replacement"
      ],
      "additionalProperties": false
    }
  }
}
