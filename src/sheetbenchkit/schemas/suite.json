{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_ref"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    }
  },
  "required": [
    "schema_version",
    "suite_id",
    "cases",
    "families",
    "content_sha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "case_ref": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "contract_path": {
          "type": "string",
          "minLength": 1
        },
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "task_path": {
          "type": "string",
          "minLength": 1
        },
        "gold_path": {
          "type": "string",
          "minLength": 1
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "task_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "gold_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "case_id",
        "contract_path",
        "manifest_path",
        "task_path",
        "gold_path",
        "contract_sha256",
        "manifest_sha256",
        "task_sha256",
        "gold_sha256"
      ],
      "additionalProperties": false
    },
    "family": {
      "type": "object",
      "properties": {
        "family_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "base": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "distractor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}(?![\\s\\S])"
        },
        "mutation_locations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      },
      "required": [
        "family_id",
        "base",
        "target",
        "distractor",
        "mutation_locations"
      ],
      "additionalProperties": false
    },
    "json": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    }
  }
}
